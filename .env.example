# Gemini Vision API 키 (OCR)
GEMINI_API_KEY=
# fanding.kr 로그인 계정 (playwright-server로 전달)
FANDING_EMAIL=
FANDING_PASSWORD=
# 기록 대상 Google Sheets ID
GOOGLE_SHEETS_SPREADSHEET_ID=
# 서비스 계정 키 경로. 로컬은 ./secrets/service-account.json 이 비어 있으면 FileNotFoundException
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/secrets/service-account.json
# 텔레그램 알림 봇 토큰과 수신 채팅 ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# KISTA 내부 인증 토큰 (X-Internal-Token 헤더)
INTERNAL_API_TOKEN=
# KISTA API 주소 (기본값과 같으면 생략 가능)
KISTA_URL=https://api.kista-app.com
# false면 내장 FandingScheduler 비활성화 (기본 true)
FIDA_SCHEDULER_ENABLED=true
# healthchecks.io dead-man's switch 핑 URL (비우면 핑 생략)
HEARTBEAT_URL=
# 스크래퍼 사이드카 주소 (기본값은 컨테이너 이름 기반이라 보통 생략)
# SCRAPER_URL=http://playwright-server:3000/scrape
# Gemini 일일 사용량 파일 (기본 /tmp/... 라 재시작 시 초기화. 서버는 /state/... 로 지정해 영속화)
# GEMINI_QUOTA_USAGE_PATH=/state/gemini-quota-usage.json
# OCR 회귀 자료(이미지·Gemini 원시 응답) 보관 경로, 60일 보관 (기본값, 서버는 /state 마운트라 설정 불필요)
OCR_ARCHIVE_PATH=/state/ocr-archive
